# RAG — Supabase pgvector (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Chat — Groq API (console.groq.com → API Keys)
GROQ_API_KEY=gsk_xxx

# Optional: Switch back to Kimi/Moonshot
# KIMI_API_KEY=sk-xxx
# baseURL: https://api.moonshot.cn/v1

# Optional: Voice mode (OpenAI Realtime API)
# OPENAI_API_KEY=sk-xxx

# Optional: Langfuse tracing (langfuse.com)
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: Email alerts for jailbreak/anomalies (resend.com)
# RESEND_API_KEY=re_xxx
# ALERT_EMAIL=you@example.com

# Optional: Online scoring in chatbot
# ENABLE_ONLINE_SCORING=true

# Optional: Prompt regression secret
# PROMPT_REGRESSION_SECRET=xxx
